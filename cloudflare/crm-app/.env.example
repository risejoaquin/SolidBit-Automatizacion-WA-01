# CRM Kapso Worker Environment Example
# Copy to .env.local and populate with your private keys

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
CRM_BUSINESS_ID=00000000-0000-0000-0000-000000000000
SESSION_SECRET=your-32-byte-hex-session-signing-secret

# QA Test Credentials (created during bootstrap)
OWNER_EMAIL=owner.qa@example.test
OWNER_PASSWORD=
WORKER_EMAIL=worker.qa@example.test
WORKER_PASSWORD=

# Kapso Configuration
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WORKER_ASSIGNEE_ID=
KAPSO_OWNER_EMBED_URL=
KAPSO_WORKER_EMBED_URL=
KAPSO_WORKER_EMBED_APPROVED=false

# Feature Flags (disabled initially)
ENABLE_SUPABASE_SYNC=false
ENABLE_KAPSO_HANDOFF_NOTICES=false
