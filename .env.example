# Documentation only: NO REAL VALUES allowed.
# Generate a private .env.local with npm run setup:local
LOCAL_DB_PATH=
PORT=
OWNER_EMAIL=
OWNER_PASSWORD=
WORKER_EMAIL=
WORKER_PASSWORD=
ENABLE_LOCAL_ORDER_SIMULATION=

# Kapso inbox: private embed URLs from official Platform API.
KAPSO_OWNER_EMBED_URL=
KAPSO_WORKER_EMBED_URL=
KAPSO_WORKER_EMBED_APPROVED=

# Optional read-only Supabase order sync. DISABLED until contract review.
ENABLE_SUPABASE_SYNC=
SUPABASE_URL=
SUPABASE_READ_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORDER_TABLE=
SUPABASE_SYNC_LIMIT=
SUPABASE_SYNC_INTERVAL_SECONDS=

# Kapso signed workflow handoff events, received via Cloudflare Worker
KAPSO_WEBHOOK_WORKER_URL=
KAPSO_WEBHOOK_SECRET=
KAPSO_PROJECT_ID=
KAPSO_WORKER_ASSIGNEE_ID=
KAPSO_EMBED_ALLOWED_ORIGIN=

# Optional approved utility template to assigned worker; off by default
ENABLE_KAPSO_HANDOFF_NOTICES=
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WORKER_PHONE=
KAPSO_HANDOFF_TEMPLATE=
KAPSO_HANDOFF_TEMPLATE_LANGUAGE=

# Supabase CRM (backend-only, never in browser)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRM_BUSINESS_SLUG=
CRM_BUSINESS_NAME=
CRM_BUSINESS_ID=
CONFIRM_STOCK_COUNTS=

# Optional remote user notices
ENABLE_KAPSO_HANDOFF_NOTICES=
# Optional remote stock process
ENABLE_SUPABASE_SYNC=
